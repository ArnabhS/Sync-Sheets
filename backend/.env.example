# Server
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# MySQL – use ONE of the two options below
# ---------------------------------------------------------------------------

# Option A: Cloud SQL connection URL (recommended – paste your provider’s link)
# Works with: PlanetScale, Railway, Aiven, Scalegrid, AWS RDS, etc.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
MYSQL_URL=
# Enable SSL for cloud (set to 1 or true for PlanetScale, Railway, etc.)
MYSQL_SSL=true

# Option B: Individual values (local or when URL is not used)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=sheets_sync

# ---------------------------------------------------------------------------
# Google Sheets API – Service Account
# ---------------------------------------------------------------------------
# Path to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional: Polling intervals (seconds)
SHEET_POLL_INTERVAL=10
DB_POLL_INTERVAL=10

# WebSocket
WS_PATH=/ws
